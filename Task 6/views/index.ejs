<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task 6 | Auth & Database</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <h2 class="fw-bold mb-4">Secure Authentication Portal</h2>
        
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm p-4">
                    <h4>Register</h4>
                    <form id="register-form">
                        <input type="text" name="name" class="form-control mb-2" placeholder="Name" required>
                        <input type="email" name="email" class="form-control mb-2" placeholder="Email" required>
                        <input type="password" name="password" class="form-control mb-3" placeholder="Password" required>
                        <button type="submit" class="btn btn-dark w-100">Register</button>
                    </form>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card shadow-sm p-4">
                    <h4>Login</h4>
                    <form id="login-form">
                        <input type="email" name="email" class="form-control mb-2" placeholder="Email" required>
                        <input type="password" name="password" class="form-control mb-3" placeholder="Password" required>
                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card shadow-sm p-4 mt-3 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="text-success m-0">Secure Dashboard</h4>
                <button id="fetch-data-btn" class="btn btn-success">Fetch Protected Data</button>
            </div>
            <pre id="secure-output" class="bg-dark text-light p-3 mt-3 rounded" style="display:none;"></pre>
        </div>
    </div>
    <script src="/script.js"></script>
</body>
</html>