

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudentHub | Registration Portal</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🎓 StudentHub</a>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="hero-section text-center">
        <div class="container">
            <div class="floating-icon mb-3">🎓</div>
            <h1 class="fw-bold display-4">Build Your Future With Technology</h1>
            <p class="lead">Join our advanced internship programs and kickstart your career.</p>
        </div>
    </section>

    <!-- COURSES SECTION -->
    <section class="container my-5">
        <h2 class="text-center fw-bold mb-4">Explore Our Courses</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card course-card h-100 p-3 text-center">
                    <h3>💻</h3>
                    <h4>Full Stack</h4>
                    <p class="text-muted">Master frontend and backend development.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card course-card h-100 p-3 text-center">
                    <h3>🐍</h3>
                    <h4>Python</h4>
                    <p class="text-muted">Learn advanced Python programming.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card course-card h-100 p-3 text-center">
                    <h3>📊</h3>
                    <h4>Data Science</h4>
                    <p class="text-muted">Analyze data and build ML models.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- REGISTRATION SECTION -->
    <section class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="registration-card">
                    <h3 class="text-center fw-bold mb-4">Student Registration</h3>
                    
                    <form action="/register" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Name</label>
                            <input type="text" class="form-control" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Email Address</label>
                            <input type="email" class="form-control" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Phone Number</label>
                            <input type="text" class="form-control" name="phone" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Select Course</label>
                            <select class="form-select" name="course">
                                <option value="Full Stack">Full Stack Development</option>
                                <option value="Python">Python</option>
                                <option value="Data Science">Data Science</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Create Account →</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer text-center">
        <div class="container">
            <h4>🎓 StudentHub</h4>
            <p>Learn. Build. Grow.</p>
            <p class="mt-3" style="font-size: 0.9rem; color: #d1d5db;">© 2024 StudentHub Inc.</p>
        </div>
    </footer>

</body>
</html>